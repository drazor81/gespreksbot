# Anthropic API Key - Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Modelkeuze (allemaal optioneel; laat leeg voor de defaults).
# ANTHROPIC_MODEL overschrijft alle modi tegelijk (backward compatible):
# ANTHROPIC_MODEL=
# Of fijnmaziger per modus:
# ANTHROPIC_MODEL_CHAT=claude-haiku-4-5-20251001      # patiënt-rollenspel (start/chat/stream)
# ANTHROPIC_MODEL_FEEDBACK=claude-sonnet-4-6   # coach/feedback + SOEP
# ANTHROPIC_MODEL_SOEP_GENEREER=                       # SOEP-casusgeneratie niveau 4 (default: CHAT_MODEL)

# Sterk, willekeurig geheim van >=32 tekens. Tekent de sessietokens EN versleutelt de SOEP-casus-tickets.
# Genereren: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_TOKEN_SECRET=replace-me-with-32-plus-random-chars

# 'development' lokaal (dev-bypass, geen Turnstile) of 'turnstile' in productie.
SESSION_AUTH_MODE=development
TURNSTILE_SECRET_KEY=

# Optioneel: pad naar Google Cloud service-account JSON (alleen voor speech-features).
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-gescheiden toegestane origins voor CORS.
FRONTEND_URL=http://localhost:5173

# Frontend: Render-origin (zonder route-suffix) en de Turnstile site key.
VITE_API_BASE=https://your-render-service.onrender.com
VITE_TURNSTILE_SITE_KEY=
